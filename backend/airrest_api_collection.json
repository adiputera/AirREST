          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.environment.get('targetUserId') === pm.environment.get('currentUserId')) {",
                  "  pm.environment.unset('token');",
                  "  pm.environment.unset('refreshToken');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
