{
  "info": {
    "_postman_id": "c1f7a4e2-63b9-4a92-8db3-982827170123",
    "name": "AirREST Backend API",
    "description": "Complete API testing collection for AirREST Go backend synchronization service with Auth, Workspaces, Teams, Projects, RBAC, and Stateless OCC Sync. Security upgrade: supply your own bootstrap credentials; no default signing or administrator secrets. Password changes/resets revoke existing sessions; a self-service change returns replacement tokens for the current device. JWT access/refresh tokens carry a required account session version. Limits: 4 MiB per body, 500 sync mutations, 100 import collections, 5000 import items, 32 levels; oversize returns 413. Busy/timeout/startup failures return 503; retry initialization with bounded backoff. Contributors may remove requests/folders but cannot delete collections/environments or move collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
