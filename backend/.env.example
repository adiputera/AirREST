PORT=8080
# For local development with Docker:
DATABASE_URL=postgres://airrest:airrest_secret_password@localhost:5432/airrest_db?sslmode=disable
# For Vercel Serverless deployments (use Neon or Supabase transaction pooler connection string):
# DATABASE_URL=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required: generate a unique signing key with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=72
JWT_REFRESH_EXPIRATION_DAYS=30

# Bootstrap email/password are required only when no superadministrator exists.
# Missing or example credentials fail startup; existing accounts are never overwritten.
SUPERADMIN_EMAIL=
# Required on first startup: choose a unique password of 12 to 72 bytes.
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Administrator

# Serverless & Connection Pooling (Optional tuning)
# DB_MAX_CONNS=4       # Defaults to 4 on Vercel, 25 on standalone Docker/VPS
# DB_MIN_CONNS=1       # Defaults to 1 on Vercel, 2 on standalone Docker/VPS
# SKIP_MIGRATIONS=false # Set to true if running migrations via CI/CD instead of on boot
