{
  "name": "airrest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "hub"
  ],
  "scripts": {
    "dev": "vite",
    "dev:offline": "vite --mode offline",
    "build": "vite build",
    "build:full": "vite build --mode full",
    "build:offline": "vite build --mode offline",
    "build:extension": "vite build",
    "build:all-extensions": "npm run build && npm run build:offline",
    "dev:hub": "npm run --prefix hub dev",
    "build:hub": "npm run --prefix hub build",
    "build:all": "npm run build && npm run build:offline && npm run build:hub",
    "preview": "vite preview",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
