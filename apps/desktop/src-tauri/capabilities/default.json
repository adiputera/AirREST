{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AirREST main-window network and user-selected file operations",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*/*" }, { "url": "https://*/*" }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-destroy"
  ]
}
