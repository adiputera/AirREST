{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop updater and window lifecycle operations",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "core:window:allow-destroy",
    "allow-start-performance-run",
    "allow-stop-performance-run",
    "allow-update-performance-variables",
    "allow-check-performance-capacity"
  ]
}
